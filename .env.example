# Supabase project settings (Project Settings -> API / API Keys)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (client-safe) key. NEVER put the service_role / secret key in a VITE_ variable.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_e46zIDcuVJ-lc2KEff7QVw_xD8T_HCd

# Base path the app is served from.
#   "/"            -> custom domain, Netlify, Vercel, Cloudflare Pages, local dev
#   "/Bookshelf/"  -> https://<user>.github.io/Bookshelf/
VITE_BASE_PATH=/
